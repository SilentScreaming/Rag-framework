include LICENSE README.md README.zh-CN.md
include requirements.txt requirements-models.txt requirements-dev.txt
include configs/paths.example.json
recursive-include configs/datasets *.example.yaml
recursive-include configs/models *.example.yaml
recursive-include configs/pipelines *.example.yaml
recursive-include configs/profiles *.example.yaml
recursive-include scripts *.py
recursive-include examples *.jsonl
recursive-include docs *.md
recursive-include tests *.py *.jsonl *.md
recursive-exclude * __pycache__ *.py[cod]
recursive-exclude configs *.local.*
prune outputs
prune .cache
prune .venv
prune .git
